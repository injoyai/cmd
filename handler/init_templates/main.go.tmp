package main

import (
	"fmt"
	"os"
	"os/signal"
	"syscall"

	"github.com/injoyai/conv/cfg"
)

// BuildDate 编译时间,由 build.sh 注入
// -ldflags="-s -w -X main.BuildDate=$(date +%Y-%m-%d)"
var BuildDate = "unknown"

func main() {
	// cfg.Default 默认加载 ./config/config.yaml 和环境变量
	// 自定义数据源可用 cfg.Init(cfg.WithFile("path"), cfg.WithEnv())
	appName := cfg.GetString("app.name", "{{.ModuleName}}")
	serverPort := cfg.GetInt("server.port", 8080)

	fmt.Printf("启动 %s, 端口: %d, 编译时间: %s\n", appName, serverPort, BuildDate)

	// 等待退出信号
	quit := make(chan os.Signal, 1)
	signal.Notify(quit, syscall.SIGINT, syscall.SIGTERM)
	<-quit

	fmt.Println("服务退出")
}
